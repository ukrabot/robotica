{
  // Configuración de Cloudflare Workers para ukrabot.cl
  // Docs: https://developers.cloudflare.com/workers/static-assets/
  //
  // El sitio sigue siendo estático (HTML, SVG e imágenes servidos tal cual).
  // El Worker (worker/index.js) solo atiende la tienda: /api/*, /admin y las
  // páginas de productos, para mostrar el precio y stock vigentes.
  //
  // Secretos que se configuran en Cloudflare (Settings > Variables and Secrets),
  // nunca en este archivo: FLOW_API_KEY, FLOW_SECRET_KEY, ADMIN_PASSWORD,
  // MP_ACCESS_TOKEN y (opcional) MP_WEBHOOK_SECRET.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robotica",
  "main": "worker/index.js",
  "compatibility_date": "2024-11-01",

  "assets": {
    // La raíz del repositorio es la raíz del sitio.
    // Las exclusiones están en .assetsignore
    "directory": "./",
    "binding": "ASSETS",

    // El sitio enlaza sin extensión (/about, /blog/mi-articulo).
    // "auto-trailing-slash" resuelve /blog/mi-articulo -> /blog/mi-articulo.html
    // y evita redirecciones 301 innecesarias que diluyen el SEO.
    "html_handling": "auto-trailing-slash",

    // Sirve 404.html con estado 404 real (evita soft 404, que perjudica
    // la indexación y las políticas de AdSense).
    "not_found_handling": "404-page",

    // Solo estas rutas pasan por el Worker; todo lo demás se sirve directo.
    "run_worker_first": ["/api/*", "/admin", "/admin/*", "/producto/*", "/productos", "/productos.html", "/productos-digitales", "/productos-digitales.html",
      "/blog", "/blog/*", "!/blog/*.jpg", "!/blog/*.svg", "!/blog/*.png", "!/blog/*.webp", "!/blog/thumbs/*"]
  },

  // Base de datos de la tienda: un Durable Object con SQLite (pedidos, precios, stock).
  "durable_objects": {
    "bindings": [{ "name": "STORE", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],

  "vars": {
    // Producción de Flow. Para pruebas: https://sandbox.flow.cl/api (con claves de sandbox).
    "FLOW_API_URL": "https://www.flow.cl/api",
    // Dirección pública a la que Flow devuelve al cliente y envía la confirmación.
    "SITE_URL": "https://www.ukrabot.cl"
  },

  "observability": { "enabled": true }
}
